generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Platform {
  INSTAGRAM
  YOUTUBE
  TIKTOK
  FACEBOOK
}

enum CollaborationType {
  PAID
  GIFTED
  EVENT
}

// User - main account
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  userName        String?  @unique // creator name like @john_doe
  category        String?  // Fashion & Style, Fitness, etc.
  bio             String?
  website         String?
  location        String?
  profileImageUrl String?
  coverImageUrl   String?
  audienceSummary String?
  customUrl       String?  @unique // for media kit: endoros.com/{customUrl}
  isMediaKitPublic Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  connectedAccounts ConnectedAccount[]
  achievements      Achievement[]
  collaborations    Collaboration[]
}

// Connected social media accounts
model ConnectedAccount {
  id             String   @id @default(cuid())
  userId         String
  platform       Platform
  platformUserId String   // ID from the platform
  username       String
  isPrimary      Boolean  @default(false)
  followers      Int      @default(0)
  accessToken    String?  // encrypted
  refreshToken   String?  // encrypted
  tokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformMetrics      PlatformMetrics[]
  audienceDemographics AudienceDemographics?

  @@unique([userId, platform, platformUserId])
}

// Achievements & Highlights
model Achievement {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  date        String   // "2023-06" format
  category    String   // Media, Events, Awards, etc.

  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Brand Collaborations
model Collaboration {
  id       String            @id @default(cuid())
  userId   String
  brand    String
  campaign String
  date     String            // "2023-06" format
  type     CollaborationType

  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Daily metrics snapshots per connected account
model PlatformMetrics {
  id                 String   @id @default(cuid())
  connectedAccountId String
  date               DateTime @db.Date

  // Core metrics
  followers       Int   @default(0)
  engagementRate  Float @default(0) // percentage
  avgViews        Int   @default(0)
  reach           Int   @default(0)

  // Engagement breakdown
  likes    Int @default(0)
  comments Int @default(0)
  shares   Int @default(0)
  saves    Int @default(0)

  // Performance metrics
  profileVisits Int @default(0)
  impressions   Int @default(0)
  storyViews    Int @default(0)
  linkClicks    Int @default(0)

  createdAt DateTime @default(now())

  // Relations
  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, date])
}

// Audience demographics per connected account
model AudienceDemographics {
  id                 String @id @default(cuid())
  connectedAccountId String @unique

  // Gender distribution (percentages)
  genderFemale Float @default(0)
  genderMale   Float @default(0)
  genderOther  Float @default(0)

  // Age distribution (percentages)
  age18_24  Float @default(0)
  age25_34  Float @default(0)
  age35_44  Float @default(0)
  age45Plus Float @default(0)

  updatedAt DateTime @updatedAt

  // Relations
  connectedAccount ConnectedAccount  @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  countries        AudienceCountry[]
}

// Top countries for audience
model AudienceCountry {
  id                     String @id @default(cuid())
  audienceDemographicsId String
  country                String
  percentage             Float

  // Relations
  audienceDemographics AudienceDemographics @relation(fields: [audienceDemographicsId], references: [id], onDelete: Cascade)

  @@unique([audienceDemographicsId, country])
}
